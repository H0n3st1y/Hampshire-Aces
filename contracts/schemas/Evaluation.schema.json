      "type": "object"
    },
    "Portfolio": {
      "additionalProperties": false,
      "properties": {
        "cash_cents": {
          "minimum": 0,
          "title": "Cash Cents",
          "type": "integer"
        },
        "positions": {
          "items": {
            "$ref": "#/$defs/Position"
          },
          "title": "Positions",
          "type": "array"
        },
        "total_value_cents": {
          "exclusiveMinimum": 0,
