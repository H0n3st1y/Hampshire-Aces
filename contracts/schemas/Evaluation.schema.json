      "additionalProperties": false,
      "properties": {
        "symbol": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Symbol",
          "type": "string"
        },
        "name": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "quantity": {
          "minimum": 0,
          "title": "Quantity",
          "type": "integer"
        },
        "price_cents": {
          "exclusiveMinimum": 0,
          "title": "Price Cents",
          "type": "integer"
        },
        "value_cents": {
          "minimum": 0,
          "title": "Value Cents",
          "type": "integer"
        }
      },
      "required": [
        "symbol",
        "name",
        "quantity",
        "price_cents",
        "value_cents"
      ],
      "title": "Position",
      "type": "object"
    },
