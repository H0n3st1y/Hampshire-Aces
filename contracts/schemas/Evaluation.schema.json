{
  "$defs": {
    "Choice": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "text": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "id",
        "text"
      ],
      "title": "Choice",
      "type": "object"
    },
    "Comparison": {
      "additionalProperties": false,
      "properties": {
        "end_value_if_executed_cents": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "End Value If Executed Cents"
        },
        "end_value_if_hold_cents": {
          "minimum": 0,
          "title": "End Value If Hold Cents",
          "type": "integer"
        },
        "execution_cost_cents": {
          "minimum": 0,
          "title": "Execution Cost Cents",
          "type": "integer"
        },
        "explanation": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        }
      },
      "required": [
        "end_value_if_executed_cents",
        "end_value_if_hold_cents",
        "execution_cost_cents",
        "explanation"
      ],
      "title": "Comparison",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "headline",
            "price_series",
            "portfolio"
          ],
          "title": "Kind",
          "type": "string"
        },
        "label": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "description": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "label",
        "description"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "Gate": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "allowed",
            "blocked",
            "unavailable"
          ],
          "title": "Status",
          "type": "string"
        },
        "rule_ids": {
          "items": {
            "maxLength": 4000,
            "minLength": 1,
            "type": "string"
          },
          "title": "Rule Ids",
          "type": "array"
        },
        "explanation": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        },
        "max_position_weight": {
          "const": 0.2,
          "default": 0.2,
          "title": "Max Position Weight",
          "type": "number"
        }
      },
      "required": [
        "status",
        "rule_ids",
        "explanation"
      ],
      "title": "Gate",
      "type": "object"
    },
    "Lesson": {
      "additionalProperties": false,
      "properties": {
        "concept": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Concept",
          "type": "string"
        },
        "explanation": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        },
        "question": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Question",
          "type": "string"
        },
        "choices": {
          "items": {
            "$ref": "#/$defs/Choice"
          },
          "maxItems": 6,
          "minItems": 2,
          "title": "Choices",
          "type": "array"
        },
        "correct_choice_id": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Correct Choice Id",
          "type": "string"
        },
        "feedback": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Feedback",
          "type": "string"
