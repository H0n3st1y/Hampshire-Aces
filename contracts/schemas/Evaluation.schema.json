      "title": "Policy Mode",
      "type": "string"
    },
    "specialists": {
      "items": {
        "$ref": "#/$defs/Specialist"
      },
      "title": "Specialists",
      "type": "array"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "title": "Evidence",
      "type": "array"
    },
    "metrics": {
