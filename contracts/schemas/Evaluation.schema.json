        },
        "quantity": {
          "minimum": 0,
          "title": "Quantity",
          "type": "integer"
        },
        "reason": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "type",
        "symbol",
        "quantity",
        "reason"
