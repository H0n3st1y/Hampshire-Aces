    "evaluation_id",
    "as_of",
    "analysis_mode",
    "policy_mode",
    "specialists",
    "evidence",
    "metrics",
    "proposal",
    "gate",
    "portfolio_before",
    "portfolio_after_action",
    "comparison",
    "warnings",
