        "position_weight_before": {
          "maximum": 1,
          "minimum": 0,
          "title": "Position Weight Before",
          "type": "number"
        },
        "position_weight_proposed": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Position Weight Proposed"
        },
        "lookback_days": {
          "minimum": 0,
          "title": "Lookback Days",
          "type": "integer"
